<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AiSimClient.MainWindow"
        Title="AI Sim Client" Width="820" Height="680">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="12">

        <!-- 连接配置 -->
        <Expander Grid.Row="0" Header="连接配置" IsExpanded="True" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*"
                 RowDefinitions="Auto,Auto,Auto"
                 Margin="0,6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="IP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Row="0" Grid.Column="1" x:Name="IpBox" Text="127.0.0.1"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="端口:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox  Grid.Row="0" Grid.Column="3" x:Name="PortBox" Text="7777"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="玩家名:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox  Grid.Row="0" Grid.Column="5" x:Name="NameBox" Text="AI Bot"/>
                <Button   Grid.Row="0" Grid.Column="6" x:Name="ConnectBtn" Content="连接" Click="ConnectBtn_OnClick" Margin="8,0,0,0"/>
                <Button   Grid.Row="0" Grid.Column="7" x:Name="DisconnectBtn" Content="断开" Click="DisconnectBtn_OnClick" IsEnabled="False" Margin="8,0,0,0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="密钥:" VerticalAlignment="Center" Margin="0,6,4,0"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="KeyBox" Text="LBoL_Network_Plugin" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="目标:" VerticalAlignment="Center" Margin="8,6,4,0"/>
                <ComboBox Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="3" x:Name="TargetCombo" MinWidth="180" PlaceholderText="(无目标)" Margin="0,6,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="状态:" VerticalAlignment="Center" Margin="0,6,4,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="7" x:Name="StatusText" Text="未连接" VerticalAlignment="Center" Margin="0,6,0,0"/>
            </Grid>
        </Expander>

        <!-- 出牌动作 -->
        <Expander Grid.Row="1" Header="出牌动作" IsExpanded="True" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="卡牌ID:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Row="0" Grid.Column="1" x:Name="CardIdBox" Text="Strike"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="卡牌名:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox  Grid.Row="0" Grid.Column="3" x:Name="CardNameBox" Text="Strike"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="卡牌类型:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox  Grid.Row="0" Grid.Column="5" x:Name="CardTypeBox" Text="Attack"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="角色ID:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox  Grid.Row="0" Grid.Column="7" x:Name="CharIdBox" Text="Reimu"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="GunName:" VerticalAlignment="Center" Margin="0,6,4,0"/>
                <TextBox  Grid.Row="1" Grid.Column="1" x:Name="GunNameBox" Text="Instant" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="GunType:" VerticalAlignment="Center" Margin="8,6,4,0"/>
                <TextBox  Grid.Row="1" Grid.Column="3" x:Name="GunTypeBox" Text="Single" Margin="0,6,0,0"/>
                <Button   Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" x:Name="PlayCardBtn" Content="出牌(OnRemoteCardUse)" Click="PlayCardBtn_OnClick" IsEnabled="False" Margin="8,6,0,0"/>
                <Button   Grid.Row="1" Grid.Column="6" x:Name="ResolveBtn" Content="结算(Resolved)" Click="ResolveBtn_OnClick" IsEnabled="False" Margin="8,6,0,0"/>
                <Button   Grid.Row="1" Grid.Column="7" x:Name="MidGameJoinBtn" Content="中途加入" Click="MidGameJoinBtn_OnClick" IsEnabled="False" Margin="8,6,0,0"/>
            </Grid>
        </Expander>

        <!-- 联机动作面板 -->
        <Expander Grid.Row="2" Header="联机动作（随机模拟）" IsExpanded="True" Margin="0,0,0,8">
            <WrapPanel Margin="0,6">
                <Button Content="交易全流程" Click="TradeBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="战斗治疗" Click="BattleHealBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="Gap治疗" Click="GapHealBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="结束回合" Click="EndTurnBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="回合边界" Click="TurnBoundaryBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="伤害上报" Click="DamageBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="状态效果" Click="StatusBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="法力消耗" Click="ManaBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="地图进入" Click="MapEnterBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="地图投票" Click="MapVoteBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="事件选择" Click="EventSelBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="事件投票" Click="EventVoteBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="复活请求" Click="ResurrectReqBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
                <Button Content="复活完成" Click="ResurrectedBtn_OnClick" Margin="0,0,8,6" MinWidth="110"/>
            </WrapPanel>
        </Expander>

        <TextBlock Grid.Row="3" Text="日志:" FontWeight="Bold" Margin="0,0,0,4"/>

        <!-- 日志面板 -->
        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Padding="4">
            <ScrollViewer x:Name="LogScroll">
                <ItemsControl x:Name="LogList"/>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>